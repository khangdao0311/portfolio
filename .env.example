# Email gửi đi (tài khoản SMTP)
MAIL_USER=your@gmail.com
# App password 16 ký tự, CÓ DẤU CÁCH, ví dụ: "abcd efgh ijkl mnop"
MAIL_PASS=
# Email NHẬN — cố định ở server. Client KHÔNG được chọn `to`
# (tránh biến endpoint thành open relay).
MAIL_TO=your@gmail.com

# Không bắt buộc — có default trong code
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
